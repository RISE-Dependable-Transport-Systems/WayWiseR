# ── step 3: .env configuration ────────────────────────────────────────────────

# wt_form <nameref_array> <title> <body_text> <label1> <default1> [<label2> <default2> ...]
# Shows all fields in a single dialog --form (one page).
# Falls back to sequential whiptail --inputbox per field when dialog is not available.
# On OK  : fills nameref_array (indexed) with the entered values.
# On Cancel/Esc: returns 1.
wt_form() {
    local -n _wf_result="$1"; local title="$2" body="$3"; shift 3
    local _labels=() _defaults=()
    while [[ $# -ge 2 ]]; do _labels+=("$1"); _defaults+=("$2"); shift 2; done
    local n=${#_labels[@]}
    if [[ "$OPT_YES" == true ]]; then _wf_result=("${_defaults[@]}"); return 0; fi
    local w; w=$(( $(tput cols 2>/dev/null || echo 80) - 4 ))
    if (( w < 70 )); then w=70; fi
    local body_lines; body_lines=$(printf '%s' "$body" | wc -l)
    local h=$(( body_lines + n + 9 ))
    if (( h > 40 )); then h=40; fi
    local form_h=$(( n < 14 ? n : 14 ))
    local max_lbl=0
    for lbl in "${_labels[@]}"; do
        if (( ${#lbl} > max_lbl )); then max_lbl=${#lbl}; fi
    done
    local field_x=$(( max_lbl + 3 ))
    local field_len=$(( w - field_x - 4 ))
    if (( field_len < 10 )); then field_len=10; fi
    if command -v dialog &>/dev/null && [[ -t 1 ]]; then
        local args=()
        for (( i=0; i<n; i++ )); do
            args+=("${_labels[$i]}" $(( i + 1 )) 1 "${_defaults[$i]}" $(( i + 1 )) "$field_x" "$field_len" 0)
        done
        local r; r=$(dialog --keep-tite --title "$title" --form "$body" "$h" "$w" "$form_h" \
            "${args[@]}" 3>&1 1>&2 2>&3); local _dlg_rc=$?; tput cnorm 2>/dev/null || true
        if (( _dlg_rc != 0 )); then return 1; fi
        mapfile -t _wf_result <<< "$r"
        # dialog omits trailing empty fields; pad array to expected length.
        while (( ${#_wf_result[@]} < n )); do _wf_result+=(""); done
    else
        echo; echo "  === $title ==="; [[ -n "$body" ]] && echo "  $body"
        _wf_result=()
        for (( i=0; i<n; i++ )); do
            local _v; read -rp "  ${_labels[$i]} [${_defaults[$i]}]: " _v
            _wf_result+=("${_v:-${_defaults[$i]}}")
        done
    fi
}

# wt_checklist <nameref_array_selected> <title> <body_text> <item1> <on|off> [<item2> <on|off> ...]
# Returns selected items in nameref_array. Returns 1 on cancel.
wt_checklist() {
    local -n _wcl_result="$1"; local title="$2" body="$3"; shift 3
    local _items=() _states=()
    while [[ $# -ge 2 ]]; do _items+=("$1"); _states+=("$2"); shift 2; done
    local n=${#_items[@]}
    if [[ "$OPT_YES" == true ]]; then
        _wcl_result=()
        for (( i=0; i<n; i++ )); do [[ "${_states[$i]}" == "on" ]] && _wcl_result+=("${_items[$i]}"); done
        return 0
    fi
    local w=$(( $(tput cols 2>/dev/null || echo 80) - 4 )); (( w < 60 )) && w=60
    local h=$(( n + 10 )); (( h > 34 )) && h=34
    if command -v whiptail &>/dev/null && [[ -t 1 ]]; then
        local args=()
        for (( i=0; i<n; i++ )); do
            local s="OFF"; [[ "${_states[$i]}" == "on" ]] && s="ON"
            args+=("${_items[$i]}" "" "$s")
        done
        local r; r=$(whiptail --title "$title" --checklist "$body" "$h" "$w" "$n" \
            "${args[@]}" 3>&1 1>&2 2>&3) || return 1
        # Split quoted words from result into array
        _wcl_result=()
        local word
        for word in $r; do _wcl_result+=("${word//\"/}"); done
    else
        echo; echo "  === $title ==="; [[ -n "$body" ]] && echo "  $body"
        _wcl_result=()
        for (( i=0; i<n; i++ )); do
            local hint="[Y/n]"; [[ "${_states[$i]}" != "on" ]] && hint="[y/N]"
            local answer; read -rp "  ${_items[$i]}? $hint: " answer
            local keep=false
            if [[ -z "$answer" ]]; then [[ "${_states[$i]}" == "on" ]] && keep=true
            elif [[ "${answer,,}" =~ ^y ]]; then keep=true; fi
            $keep && _wcl_result+=("${_items[$i]}")
        done
    fi
}

# wt_radiolist <nameref> <title> <body_text> <current> item1 item2 ...
# Returns 1 on cancel.
wt_radiolist() {
    local -n _wrl_ref="$1"; local title="$2" body="$3" current="$4"; shift 4
    local items=("$@"); local n=${#items[@]}
    if [[ "$OPT_YES" == true ]]; then _wrl_ref="$current"; return 0; fi
    local w=$(( $(tput cols 2>/dev/null || echo 80) - 4 )); (( w < 60 )) && w=60
    local h=$(( n + 10 )); (( h > 20 )) && h=20
    if command -v whiptail &>/dev/null && [[ -t 1 ]]; then
        local rl=()
        for item in "${items[@]}"; do
            local s="OFF"; [[ "$item" == "$current" ]] && s="ON"
            rl+=("$item" "" "$s")
        done
        local r; r=$(whiptail --title "$title" --radiolist "$body" "$h" "$w" "$n" \
            "${rl[@]}" 3>&1 1>&2 2>&3) || return 1
        _wrl_ref="${r//\"/}"
    else
        echo; echo "  === $title ==="; [[ -n "$body" ]] && echo "  $body"
        local i=1
        for item in "${items[@]}"; do
            local m=" "; [[ "$item" == "$current" ]] && m="*"
            echo "    $i) [$m] $item"; (( i++ ))
        done
        local choice; read -rp "  Choice (Enter = keep [$current]): " choice
        if [[ -n "$choice" ]]; then
            local idx=$(( choice - 1 ))
            (( idx >= 0 && idx < n )) && _wrl_ref="${items[$idx]}" || _wrl_ref="$current"
        else _wrl_ref="$current"; fi
    fi
}

# wt_password <nameref> <title> <prompt>
# Returns 1 on cancel.
wt_password() {
    local -n _wp_ref="$1"; local title="$2" prompt="$3"
    if [[ "$OPT_YES" == true ]]; then _wp_ref=""; return 0; fi
    local w=$(( $(tput cols 2>/dev/null || echo 80) - 4 )); (( w < 60 )) && w=60
    if command -v whiptail &>/dev/null && [[ -t 1 ]]; then
        local r; r=$(whiptail --title "$title" --passwordbox "$prompt" 9 "$w" \
            3>&1 1>&2 2>&3) || return 1
        _wp_ref="$r"
    else
        read -rsp "  $prompt: " _wp_ref; echo
    fi
}

configure_env() {
    local configure_script="$REPO_DIR/waywiser/scripts/configure_env.bash"
    [[ -x "$configure_script" ]] || die "Configure script not found: $configure_script"

    WAYWISER_ENV_FILE="$ENV_FILE" \
    WAYWISER_ENV_FILE_EXAMPLE="$ENV_EXAMPLE" \
    WAYWISER_REPO_DIR="$REPO_DIR" \
    bash "$configure_script" $(yes_args --quiet)
}

# ── step 4: Python virtual environment ───────────────────────────────────────

setup_venv() {
    header "Setting up Python virtual environment"
    [[ -f "$REPO_DIR/.python-version" ]] || die ".python-version not found in $REPO_DIR"
    local py_ver; py_ver=$(cat "$REPO_DIR/.python-version")
    local skipped=""
    local setup_venv_script="$REPO_DIR/waywiser/scripts/setup_venv.bash"
    local -a setup_args

    [[ -x "$setup_venv_script" ]] || die "setup_venv script not found: $setup_venv_script"
    ensure_env_file
    [[ -f "$ENV_FILE" ]] && skipped=$(env_get WAYWISER_SKIPPED_PACKAGES)

    cd "$WAYWISER_WS"
    setup_args=(
        --repo-dir "$REPO_DIR"
        --venv "$VENV_DIR"
        --skipped-packages "$skipped"
        --python "$py_ver"
        --editable
        --quiet
    )
    prepare_venv_path
    # In reuse mode an empty mounted venv directory is expected on first run,
    # so only force a clear when reuse is disabled.
    if [[ "${WAYWISER_REUSE_VENV:-}" != "true" ]]; then
        setup_args+=(--clear)
    fi
    WAYWISER_REPO_DIR="$REPO_DIR" \
    WAYWISER_PYPROJECT="$REPO_DIR/pyproject.toml" \
    WAYWISER_SKIPPED_PACKAGES="$skipped" \
    WAYWISER_PYTHON_EXTRAS="${WAYWISER_PYTHON_EXTRAS:-}" \
        bash "$setup_venv_script" "${setup_args[@]}"
    ensure_workspace_venv_link
    # shellcheck disable=SC1091
    source "$VENV_DIR/bin/activate"
    export PYTHONPATH="$VENV_DIR/lib/python${py_ver}/site-packages:${PYTHONPATH:-}"
    info "Python $py_ver venv ready at $VENV_DIR"
}

# ── step 5: ROS dependencies ─────────────────────────────────────────────────

install_ros_deps() {
    header "Installing dependencies"
    cd "$WAYWISER_WS"

    # shellcheck disable=SC1091
    [[ -f "$VENV_DIR/bin/activate" ]] && source "$VENV_DIR/bin/activate"
    ensure_ros2_environment
    ensure_env_file
    set -a; source "$ENV_FILE"; set +a

    local skipped="${WAYWISER_SKIPPED_PACKAGES:-}"
    local -a base_paths=("$WAYWISER_WS/src")
    [[ " $skipped " != *" waywiser_carla "* ]] \
        && base_paths+=("$REPO_DIR/waywiser_carla/external/carla-ros-bridge")

    local paths
    if [[ -n "$skipped" ]]; then
        local skip_pattern
        skip_pattern=$(echo "$skipped" | tr ' ' '|')
        paths=$(colcon list --base-paths "${base_paths[@]}" --paths-only \
            | grep -Evw "$skip_pattern" || true)
    else
        paths=$(colcon list --base-paths "${base_paths[@]}" --paths-only)
    fi

    [[ -n "$paths" ]] || die "No packages found to install dependencies for."

    # These packages have no apt entry or are handled by the WayWiseR venv.
    # px4_msgs: generated by waywiser_core from the PX4-Autopilot submodule
    # carla_msgs: built from carla-ros-bridge submodule
    # python-transforms3d-pip: installed through the waywiser_carla Python extra;
    # rosdep's pip installer requires a system `pip` command on minimal installs.
    local skip_keys="px4_msgs carla_msgs python-transforms3d-pip"

    # Check first — skip apt-get update and sudo if everything is already installed.
    local check_rc=0
    local check_output
    # shellcheck disable=SC2086
    check_output=$(run_rosdep check --from-paths $paths \
        --ignore-src --rosdistro "$ROS_DISTRO" \
        --skip-keys "$skip_keys" 2>&1) || check_rc=$?
    if [[ $check_rc -eq 0 ]]; then
        info "All required rosdeps already installed — skipping."
        return 0
    fi

    if command -v apt-get &>/dev/null \
        && grep -Eq '(^|[[:space:]])apt[[:space:]]' <<< "$check_output"; then
        if [[ "$(id -u)" -eq 0 ]]; then
            apt-get update
        else
            sudo apt-get update
        fi
    fi

    # shellcheck disable=SC2086
    rosdep install --from-paths $paths \
        --ignore-src --rosdistro "$ROS_DISTRO" \
        --skip-keys "$skip_keys" -r $(yes_args -y)
    info "Dependencies installed."
}

# ── step 6: build workspace ───────────────────────────────────────────────────

build_workspace() {
    header "Building workspace"
    cd "$WAYWISER_WS"

    # shellcheck disable=SC1091
    [[ -f "$VENV_DIR/bin/activate" ]] && source "$VENV_DIR/bin/activate"
    ensure_ros2_environment
    source_underlay
    ensure_env_file
    set -a; source "$ENV_FILE"; set +a

    local skipped="${WAYWISER_SKIPPED_PACKAGES:-}"
    local selected="${WAYWISER_BUILD_PACKAGES:-}"
    local up_to="${WAYWISER_PACKAGES_UP_TO:-}"
    local -a base_paths=("$WAYWISER_WS/src")
    local -a extra_args=()
    local -a allow_overriding=()
    local -a cmake_args=(
        -U_lib
        "-U*_LIBRARY"
        "-U*_LIBRARIES"
    )
    local -a event_handlers=(console_stderr-)
    local -a package_args=()
    local notification_extension="colcon_core.event_handler.desktop_notification"
    local colcon_extension_blocklist="${COLCON_EXTENSION_BLOCKLIST:-}"

    if [[ ":$colcon_extension_blocklist:" != *":$notification_extension:"* ]]; then
        colcon_extension_blocklist+="${colcon_extension_blocklist:+:}$notification_extension"
    fi

    if [[ " $skipped " != *" waywiser_carla "* ]]; then
        base_paths+=("$REPO_DIR/waywiser_carla/external/carla-ros-bridge")
        allow_overriding+=(waywiser waywiser_description)
    fi

    if [[ -n "${WAYWISER_CMAKE_ARGS:-}" ]]; then
        # shellcheck disable=SC2206
        local -a extra_cmake_args=($WAYWISER_CMAKE_ARGS)
        cmake_args+=("${extra_cmake_args[@]}")
    fi
    extra_args+=(--cmake-args "${cmake_args[@]}")

    # In quiet/CI mode suppress per-package live output from successful builds.
    if [[ "$OPT_YES" == true || "${CI:-}" == "true" ]]; then
        event_handlers+=(console_direct-)
    fi

    # Suppress per-package stderr recap blocks from successful legacy packages.
    extra_args+=(--event-handlers "${event_handlers[@]}")

    if [[ -n "$up_to" ]]; then
        # shellcheck disable=SC2206
        package_args=(--packages-up-to $up_to)
        # shellcheck disable=SC2206
        allow_overriding+=($up_to)
        info "Building up to packages (incl. deps): $up_to"
    elif [[ -n "$selected" ]]; then
        # shellcheck disable=SC2206
        package_args=(--packages-select $selected)
        # shellcheck disable=SC2206
        allow_overriding+=($selected)
        info "Building selected packages: $selected"
    fi

    if [[ ${#package_args[@]} -gt 0 ]] && colcon_supports_allow_overriding; then
        local colcon_list_output=""
        if [[ -n "$skipped" ]]; then
            # shellcheck disable=SC2086
            colcon_list_output=$(
                colcon list --base-paths "${base_paths[@]}" "${package_args[@]}" \
                    --packages-skip $skipped --names-only 2>/dev/null || true
            )
        else
            colcon_list_output=$(
                colcon list --base-paths "${base_paths[@]}" "${package_args[@]}" \
                    --names-only 2>/dev/null || true
            )
        fi
        if [[ -n "$colcon_list_output" ]]; then
            mapfile -t allow_overriding < <(
                printf '%s\n' "${allow_overriding[@]}" $colcon_list_output \
                    | awk 'NF && !seen[$0]++'
            )
        fi
    fi

    if [[ ${#allow_overriding[@]} -gt 0 ]] && colcon_supports_allow_overriding; then
        extra_args+=(--allow-overriding "${allow_overriding[@]}")
    fi

    if [[ -n "$skipped" ]]; then
        # shellcheck disable=SC2086
        COLCON_EXTENSION_BLOCKLIST="$colcon_extension_blocklist" \
            colcon build --symlink-install \
            --base-paths "${base_paths[@]}" \
            "${extra_args[@]}" \
            "${package_args[@]}" \
            --packages-skip $skipped
    else
        COLCON_EXTENSION_BLOCKLIST="$colcon_extension_blocklist" \
            colcon build --symlink-install \
            --base-paths "${base_paths[@]}" \
            "${extra_args[@]}" \
            "${package_args[@]}"
    fi
    info "Workspace build complete."
}

# ── step 7: optional activate hook ───────────────────────────────────────────

setup_activate_hook() {
    local venv_activate="$VENV_DIR/bin/activate"
    [[ -f "$venv_activate" ]] || return 0
    
    if grep -q "WayWiseR Environment Setup" "$venv_activate" 2>/dev/null; then
        info "Activate hook already present in .venv/bin/activate."
        return 0
    fi
    
    local py_ver; py_ver=$(cat "$REPO_DIR/.python-version")
    cat >> "$venv_activate" <<EOT

# WayWiseR Environment Setup
# Load runtime config: prefer repo .env, fall back to deb conffile.
if [ -f "\$WAYWISER_WS/src/WayWiseR/.env" ]; then
    set -a; source "\$WAYWISER_WS/src/WayWiseR/.env"; set +a
elif [ -f /etc/waywiser/waywiser.env ]; then
    set -a; source /etc/waywiser/waywiser.env; set +a
fi
if [ -z "\${ROS_DISTRO:-}" ]; then
    if [ -f /opt/ros/humble/setup.bash ]; then
        set +u; source /opt/ros/humble/setup.bash; set -u
    else
        echo "WARNING: ROS2 is not sourced. Source your ROS2 environment before using this workspace." >&2
    fi
fi
export PYTHONPATH=$VENV_DIR/lib/python${py_ver}/site-packages:\${PYTHONPATH:-}
if [ -f "\$WAYWISER_WS/install/setup.bash" ]; then
    set +u; source "\$WAYWISER_WS/install/setup.bash"; set -u
fi
EOT
    info "Activate hook added."
    info "From now on, 'source $VENV_DIR/bin/activate' sets up everything."
}

# ── simulation pre/post setup ─────────────────────────────────────────────────

# Run before install_ros_deps and build: initialise external sources and install
# Python requirements for selected packages and core PX4 interfaces/SITL.
presim_setup() {
    ensure_env_file
    local skipped
    skipped=$(env_get WAYWISER_SKIPPED_PACKAGES)

    header "Pre-setup: waywiser_core PX4"
    init_px4_submodules
    info "Ensuring PX4 Python requirements from pyproject extra are installed..."
    activate_env
    cd "$WAYWISER_WS"
    run_uv_install pip install -e "$REPO_DIR[px4]"

    if [[ " $skipped " != *" waywiser_carla "* ]]; then
        header "Pre-setup: waywiser_carla"
        info "Initializing carla-ros-bridge submodule..."
        git -C "$REPO_DIR" submodule update --init --recursive \
            waywiser_carla/external/carla-ros-bridge
        activate_env
        cd "$WAYWISER_WS"
        info "Ensuring CARLA Python requirements from pyproject extra are installed..."
        run_uv_install pip install -e "$REPO_DIR[waywiser_carla]"

        local custom_carla_root
        custom_carla_root=$(env_get WAYWISER_CUSTOM_CARLA_ROOT)
        if [[ -n "$custom_carla_root" ]]; then
            custom_carla_root=$(eval echo "$custom_carla_root")
            local py_ver wheel_path
            py_ver=$(python3 -c 'import sys; print(f"cp{sys.version_info.major}{sys.version_info.minor}")')
            wheel_path=$(find "$custom_carla_root/PythonAPI/carla/dist" -name "*${py_ver}*.whl" 2>/dev/null | head -n 1)
            if [[ -n "$wheel_path" && -f "$wheel_path" ]]; then
                info "Installing custom CARLA wheel: $wheel_path"
                run_uv_install pip install --force-reinstall "$wheel_path"
            else
                warn "No suitable carla wheel found in $custom_carla_root/PythonAPI/carla/dist/ for $py_ver"
            fi
        fi
    fi

    if [[ " $skipped " != *" waywiser_gazebo "* ]]; then
        header "Pre-setup: waywiser_gazebo"
        info "Initializing ros_gz_harmonic submodule..."
        git -C "$REPO_DIR" submodule update --init --recursive \
            waywiser_gazebo/external/ros_gz_harmonic
        init_px4_sitl_submodules
    fi

    if [[ " $skipped " != *" waywiser_perception "* ]]; then
        header "Pre-setup: waywiser_perception"
        local arch; arch=$(uname -m)
        activate_env
        cd "$WAYWISER_WS"
        if is_jetson; then
            # ── Jetson (aarch64) ──────────────────────────────────────────
            # TensorRT, CUDA, and cuDNN come from JetPack; install the
            # supporting system libraries that pycuda and libnvinfer need.
            info "Detected NVIDIA Jetson. Installing Jetson-specific apt packages..."
            prompt_yn "Install Jetson perception apt dependencies (sudo apt-get install)?" true \
                || { info "Skipping Jetson apt packages."; return 0; }
            sudo apt-get update -qq
            sudo apt-get install $(yes_args -y) \
                python3-pip \
                libopenblas-base \
                libopenmpi-dev \
                libomp-dev \
                python3-libnvinfer-dev \
                libjpeg-dev \
                zlib1g-dev \
                libpython3-dev \
                libavcodec-dev \
                libavformat-dev \
                libswscale-dev
            info "Installing pycuda..."
            run_uv_install pip install pycuda
            warn "torch and torchvision for Jetson must be installed manually."
            warn "Follow the NVIDIA instructions at:"
            warn "  https://forums.developer.nvidia.com/t/pytorch-for-jetson/"
            warn "After installing torch/torchvision, re-run 'make build'."
        elif [[ "$arch" == "aarch64" ]]; then
            info "Detected aarch64 without Jetson markers — skipping Jetson-specific perception apt packages."
        else
            # ── x86_64 ────────────────────────────────────────────────────
            # torch and torchvision are already pulled in via the
            # waywiser_perception_x86 extra in setup_venv.
            # Install pycuda only when a CUDA toolkit is present, since it
            # requires CUDA headers to compile its native extension.
            local nvcc_bin=""
            if command -v nvcc &>/dev/null; then
                nvcc_bin=$(command -v nvcc)
            elif [[ -x /usr/local/cuda/bin/nvcc ]]; then
                nvcc_bin=/usr/local/cuda/bin/nvcc
            fi
            if [[ -n "$nvcc_bin" ]]; then
                info "CUDA toolkit detected ($nvcc_bin). Installing pycuda..."
                run_uv_install pip install pycuda
            else
                info "CUDA toolkit not found — skipping pycuda."
                info "To enable GPU acceleration later, install the CUDA toolkit:"
                info "  https://docs.nvidia.com/cuda/cuda-installation-guide-linux/"
                info "Then run: uv pip install pycuda"
            fi
        fi
    fi
}

agrarsense_post_build() {
    ensure_env_file
    local skipped
    skipped=$(env_get WAYWISER_SKIPPED_PACKAGES)
    [[ " $skipped " != *" waywiser_agrarsense "* ]] || return 0

    header "Post-build: waywiser_agrarsense"
    if [[ "${CI:-}" == "true" ]]; then
        info "CI environment detected — skipping local Docker setup for waywiser_agrarsense."
        return 0
    fi

    if ! command -v docker &>/dev/null; then
        warn "Docker is not installed; skipping waywiser_agrarsense Docker setup."
        warn "Install and configure Docker, then run: make post-build"
        return 0
    fi

    if ! docker info &>/dev/null 2>&1; then
        warn "Docker is installed but not usable by this user; skipping waywiser_agrarsense Docker setup."
        warn "Start Docker or configure permissions/rootless Docker, then run: make post-build"
        return 0
    fi

    local docker_script="$REPO_DIR/waywiser_agrarsense/ros_bridge/build_docker_container.sh"
    if [[ ! -f "$docker_script" ]]; then
        warn "Agrarsense Docker build script not found: $docker_script"
        return 0
    fi

    bash "$docker_script"
}

run_post_build() {
    header "Running post-build setup"
    agrarsense_post_build
}

# ── main ─────────────────────────────────────────────────────────────────────────

main() {
    ensure_git_safe_directory

    # ── core workspace setup ───────────────────────────────────────────────
    if [[ "$OPT_CONFIGURE_ONLY" == true ]]; then
        configure_env || { echo; info "Configuration cancelled."; exit 0; }
        echo; info "Done. Run 'make setup' to install prerequisites and dependencies."
        return 0
    fi

    if [[ "$OPT_POST_BUILD_ONLY" == true ]]; then
        apply_env_overrides
        run_post_build
        return 0
    elif [[ "$OPT_BUILD_ONLY" == true ]]; then
        apply_env_overrides
        build_workspace
        setup_activate_hook
    elif [[ "$OPT_SETUP_ONLY" == true ]]; then
        apply_env_overrides
        if [[ "$OPT_SKIP_PREREQS" != true ]]; then
            check_prerequisites
        fi
        init_submodules
        setup_venv
        presim_setup
        install_ros_deps
        echo
        if [[ "$MAVSDK_MANUAL_INSTALL" == true ]]; then
            warn "MAVSDK must be installed manually for your architecture."
            warn "Download from: https://github.com/mavlink/MAVSDK/releases"
            warn "Then run: sudo dpkg -i libmavsdk-dev*.deb"
            warn "After that, run 'make build' to build the workspace."
        else
            info "Setup complete. Run 'make build' to build the workspace."
        fi
        return 0
    elif [[ "$OPT_PREREQS_ONLY" == true ]]; then
        check_prerequisites
        echo; info "Prerequisites installed. Run 'make setup' to continue."
        return 0
    else
        apply_env_overrides
        configure_env || { echo; info "Configuration cancelled."; exit 0; }
        if [[ "$OPT_SKIP_PREREQS" != true ]]; then
            check_prerequisites
        fi
        init_submodules
        setup_venv
        presim_setup
        install_ros_deps
        if [[ "$MAVSDK_MANUAL_INSTALL" == true ]]; then
            echo
            warn "MAVSDK must be installed manually for your architecture."
            warn "Download from: https://github.com/mavlink/MAVSDK/releases"
            warn "Then run: sudo dpkg -i libmavsdk-dev*.deb"
            warn "After that, run 'make build' to build the workspace."
            exit 0
        fi
        build_workspace
        run_post_build
        setup_activate_hook
    fi
    
    echo
    echo "==================================================="
    echo "  Installation complete!"
    echo "==================================================="
    echo
    echo "  Source the workspace:"
    echo "    source $WAYWISER_WS/.venv/bin/activate"
    echo
}

main
