#!/usr/bin/env bash
# bootstrap — WayWiseR workspace bootstrap: first-time setup and simulation packages.
#
# Usage: make all ARGS="<options>"
#
# Options:
#   --prereqs-only   Only install system prerequisites, then exit
#   --setup-only     Install prereqs + venv + rosdep, then exit (no build)
#   --skip-prereqs   Skip system prerequisites (assume already installed)
#   --skip-mavsdk    Skip MAVSDK check/install
#   --configure      (Re-)configure .env only, then exit
#   --build-only     Skip setup; only run colcon build
#   --post-build-only  Run post-build setup hooks, then exit
#   -y, --yes, --quiet  Non-interactive: accept all defaults
#   -h, --help       Show this help and exit
#
# Simulation packages are set up automatically from .env (WAYWISER_SKIPPED_PACKAGES).
# Run 'make configure' to change which packages are built.
#
# Environment variables:
#   WAYWISER_WS   Workspace root (auto-detected from script location if unset)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
WAYWISER_WS="${WAYWISER_WS:-$(cd "$REPO_DIR/../.." && pwd)}"
# ENV_FILE resolution order:
#   1. WAYWISER_ENV_FILE env var (explicit override)
#   2. <repo>/.env  (source install, the normal case)
#   3. /etc/waywiser/waywiser.env  (deb install conffile)
if [[ -n "${WAYWISER_ENV_FILE:-}" ]]; then
    ENV_FILE="$WAYWISER_ENV_FILE"
elif [[ -f "$REPO_DIR/.env" ]]; then
    ENV_FILE="$REPO_DIR/.env"
else
    ENV_FILE="/etc/waywiser/waywiser.env"
fi
ENV_EXAMPLE="${WAYWISER_ENV_FILE_EXAMPLE:-$REPO_DIR/.env.example}"
VENV_DIR="${WAYWISER_VENV_PATH:-$WAYWISER_WS/.venv}"

# ── helpers ───────────────────────────────────────────────────────────────────
header() { echo; echo "===> $*"; echo; }
die()    { echo "ERROR: $*" >&2; exit 1; }
info()   { echo "  $*"; }
warn()   { echo "  WARNING: $*" >&2; }
run_uv_install() {
    if [[ ! -t 2 || "${TERM:-dumb}" == "dumb" ]]; then
        UV_NO_PROGRESS=1 uv "$@"
        return
    fi

    local log_file pid rc=0 frame_index=0 latest_status="Installing Python dependencies"
    local frames=('|' '/' '-' '\')
    log_file="$(mktemp "${TMPDIR:-/tmp}/waywiser-uv.XXXXXX")"

    UV_NO_PROGRESS=1 uv --color never "$@" >"$log_file" 2>&1 &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        latest_status="$(
            grep -E '^[[:space:]]*(Building|Downloading|Preparing|Installing) ' "$log_file" \
                | tail -n 1 \
                | sed 's/^[[:space:]]*//' \
                || true
        )"
        [[ -n "$latest_status" ]] || latest_status="Installing Python dependencies"
        printf '\r\033[2K  %s... %s' \
            "${latest_status%...}" "${frames[$frame_index]}" >&2
        frame_index=$(( (frame_index + 1) % ${#frames[@]} ))
        sleep 0.1
    done

    wait "$pid" || rc=$?
    printf '\r\033[2K' >&2
    if (( rc != 0 )); then
        cat "$log_file" >&2
        rm -f "$log_file"
        return "$rc"
    fi

    awk '!/^[[:space:]]*(Building|Downloading|Preparing|Installing) /' "$log_file" >&2
    rm -f "$log_file"
}
yes_args() {
    [[ "$OPT_YES" == true ]] && printf '%s\n' "$@"
    return 0
}
as_root() {
    if [[ "$(id -u)" -eq 0 ]]; then
        "$@"
    else
        sudo "$@"
    fi
}

ensure_git_safe_directory() {
    command -v git &>/dev/null || return 0

    if [[ "${CI:-}" == "true" ]]; then
        git config --global --add safe.directory '*' || \
            warn "Unable to mark Git directories as safe for CI."
    elif [[ "$(id -u)" -eq 0 ]]; then
        git config --global --add safe.directory "$REPO_DIR" || \
            warn "Unable to mark $REPO_DIR as a safe Git directory."
    fi
}

ensure_env_file() {
    if [[ ! -f "$ENV_FILE" ]]; then
        local env_dir
        env_dir="$(dirname "$ENV_FILE")"
        mkdir -p "$env_dir" 2>/dev/null || as_root mkdir -p "$env_dir"
        if cp "$ENV_EXAMPLE" "$ENV_FILE" 2>/dev/null; then
            :
        elif [[ -w "$env_dir" ]]; then
            cp "$ENV_EXAMPLE" "$ENV_FILE"
        else
            as_root cp "$ENV_EXAMPLE" "$ENV_FILE"
        fi
        info "Created $ENV_FILE from $ENV_EXAMPLE."
    fi
}

apply_env_overrides() {
    ensure_env_file
    if [[ -n "${WAYWISER_SKIPPED_PACKAGES+x}" ]]; then
        if [[ -n "${WAYWISER_SKIPPED_PACKAGES}" ]]; then
            env_set WAYWISER_SKIPPED_PACKAGES "\"${WAYWISER_SKIPPED_PACKAGES}\""
        else
            env_set WAYWISER_SKIPPED_PACKAGES ""
        fi
    fi
}

# Read a single key from an env file, stripping quotes.
env_get() { grep -m1 "^${1}=" "${2:-$ENV_FILE}" 2>/dev/null | cut -d= -f2- | tr -d '"'"'" || true; }
# Write/update a key in ENV_FILE; appends if the key is absent.
env_set() {
    local key="$1" val="$2"
    ensure_env_file
    if grep -q "^${key}=" "$ENV_FILE" 2>/dev/null; then
        if [[ -w "$ENV_FILE" ]]; then
            sed -i "s|^${key}=.*|${key}=${val}|" "$ENV_FILE"
        else
            as_root sed -i "s|^${key}=.*|${key}=${val}|" "$ENV_FILE"
        fi
    else
        if [[ -w "$ENV_FILE" ]]; then
            printf '%s=%s\n' "$key" "$val" >> "$ENV_FILE"
        else
            printf '%s=%s\n' "$key" "$val" | as_root tee -a "$ENV_FILE" > /dev/null
        fi
    fi
}
# Source ROS setup files with nounset suspended because ROS setup may reference
# variables (e.g. AMENT_TRACE_SETUP_FILES) that are not exported yet.
source_ros() {
    local f="$1"
    [[ -f "$f" ]] || die "ROS setup not found: $f"
    set +u
    # shellcheck disable=SC1090
    source "$f"
    set -u
    prune_missing_prefix_paths
}

source_underlay() {
    local setup_file="${WAYWISER_UNDERLAY_SETUP:-}"
    [[ -n "$setup_file" ]] || return 0
    if [[ ! -f "$setup_file" ]]; then
        if [[ "${CI:-}" == "true" ]]; then
            warn "Underlay setup not found, continuing without it: $setup_file"
            return 0
        fi
        die "Underlay setup not found: $setup_file"
    fi

    set +u
    # shellcheck disable=SC1090
    source "$setup_file"
    set -u
    prune_missing_prefix_paths
    info "Sourced underlay: $setup_file"
}

ensure_ros2_environment() {
    local ros_distro="${ROS_DISTRO:-humble}"
    local ros_prefix="/opt/ros/$ros_distro"

    if [[ -n "${ROS_DISTRO:-}" && ":${AMENT_PREFIX_PATH:-}:" == *":$ros_prefix:"* ]]; then
        prune_missing_prefix_paths
        info "Using sourced ROS2 environment: $ROS_DISTRO"
        return 0
    fi

    local default_setup="$ros_prefix/setup.bash"
    if [[ -f "$default_setup" ]]; then
        source_ros "$default_setup"
        info "Sourced ROS2 environment from $default_setup"
        return 0
    fi

    die "ROS2 is not sourced and $default_setup does not exist.
Please source your ROS2 environment before running make, for example:
  source $default_setup"
}

colcon_supports_allow_overriding() {
    colcon build --help 2>/dev/null | grep -q -- "--allow-overriding"
}

# Drop stale overlay prefixes left behind by a previously sourced install space.
# This avoids noisy colcon warnings after build/, install/, or selected packages
# have been cleaned since the user's shell was last sourced.
prune_missing_prefix_paths() {
    local var value IFS entry new_value
    local -a prefix_vars=(
        AMENT_PREFIX_PATH
        CMAKE_PREFIX_PATH
        COLCON_PREFIX_PATH
    )

    for var in "${prefix_vars[@]}"; do
        value="${!var:-}"
        [[ -n "$value" ]] || continue

        new_value=""
        IFS=':'
        for entry in $value; do
            [[ -z "$entry" || -e "$entry" ]] || continue
            new_value+="${new_value:+:}$entry"
        done
        unset IFS

        if [[ -n "$new_value" ]]; then
            export "$var=$new_value"
        else
            unset "$var"
        fi
    done
}

# Activate venv + ROS (used by sim package functions).
activate_env() {
    local venv="$VENV_DIR"
    [[ -f "$venv/bin/activate" ]] \
        || die "Python venv not found at $venv — run 'make setup' first."
    set +u
    # shellcheck disable=SC1090
    source "$venv/bin/activate"
    set -u
    ensure_ros2_environment
}

# Return 0 (true) if an NVIDIA GPU is accessible on this machine.
has_nvidia_gpu() {
    if command -v nvidia-smi &>/dev/null && nvidia-smi &>/dev/null 2>&1; then
        return 0
    fi
    if ls /dev/nvidia0 &>/dev/null 2>&1; then
        return 0
    fi
    return 1
}

# Return 0 (true) when the current machine looks like an NVIDIA Jetson.
is_jetson() {
    [[ -f /etc/nv_tegra_release ]] && return 0
    dpkg -s nvidia-l4t-core &>/dev/null && return 0

    if [[ -r /proc/device-tree/model ]] \
        && tr -d '\0' < /proc/device-tree/model 2>/dev/null | grep -qi 'nvidia.*jetson'; then
        return 0
    fi

    return 1
}

# Remove $1 from WAYWISER_SKIPPED_PACKAGES in .env (idempotent).
remove_from_skip() {
    local pkg="$1"
    [[ -f "$ENV_FILE" ]] || return 0
    local current
    current=$(grep '^WAYWISER_SKIPPED_PACKAGES=' "$ENV_FILE" | head -1 \
    | sed 's/^WAYWISER_SKIPPED_PACKAGES=//;s/"//g')
    [[ -z "$current" ]] && return 0
    local new_val
    new_val=$(printf '%s\n' $current | grep -vxF "$pkg" | xargs || true)
    if [[ -n "$new_val" ]]; then
        sed -i "s|^WAYWISER_SKIPPED_PACKAGES=.*|WAYWISER_SKIPPED_PACKAGES=\"$new_val\"|" "$ENV_FILE"
    else
        sed -i "s|^WAYWISER_SKIPPED_PACKAGES=.*|WAYWISER_SKIPPED_PACKAGES=|" "$ENV_FILE"
    fi
    info "Updated .env: removed '$pkg' from WAYWISER_SKIPPED_PACKAGES"
}

ensure_workspace_venv_link() {
    if [[ "${WAYWISER_NO_WORKSPACE_VENV_LINK:-}" == "true" ]]; then
        return 0
    fi

    local workspace_venv="$WAYWISER_WS/.venv"
    if [[ "$VENV_DIR" != "$workspace_venv" ]]; then
        rm -rf "$workspace_venv"
        ln -sfn "$VENV_DIR" "$workspace_venv"
    fi
}

prepare_venv_path() {
    if [[ -L "$VENV_DIR" ]]; then
        if [[ "${WAYWISER_REUSE_VENV:-}" == "true" && -x "$VENV_DIR/bin/python" ]]; then
            return 0
        fi
        info "Removing stale venv symlink at $VENV_DIR"
        rm "$VENV_DIR"
    fi
}

usage() {
    cat <<EOF
Usage: $(basename "$0") [options]

Core workspace setup:
  --prereqs-only   Only install system prerequisites, then exit
  --skip-prereqs   Skip system prerequisites (assume already installed)
  --skip-mavsdk    Skip MAVSDK check/install
  --configure      (Re-)configure .env only, then exit
  --build-only     Skip setup; only run colcon build
  --post-build-only  Run post-build setup hooks, then exit
  -y, --yes, --quiet  Non-interactive: accept all defaults
  -h, --help       Show this help and exit

Simulation packages are set up automatically from .env (WAYWISER_SKIPPED_PACKAGES).
Run 'make configure' to change which packages are built.

Workspace : $WAYWISER_WS
Repository: $REPO_DIR
EOF
}

# ── option parsing ────────────────────────────────────────────────────────────
OPT_PREREQS_ONLY=false
OPT_SETUP_ONLY=false
MAVSDK_MANUAL_INSTALL=false
OPT_SKIP_PREREQS=false
OPT_SKIP_MAVSDK=false
OPT_CONFIGURE_ONLY=false
OPT_BUILD_ONLY=false
OPT_POST_BUILD_ONLY=false
OPT_YES=false


while [[ $# -gt 0 ]]; do
    case "$1" in
            --prereqs-only)  OPT_PREREQS_ONLY=true ;;
            --setup-only)    OPT_SETUP_ONLY=true ;;
            --skip-prereqs)  OPT_SKIP_PREREQS=true ;;
            --skip-mavsdk)   OPT_SKIP_MAVSDK=true ;;
            --configure)     OPT_CONFIGURE_ONLY=true ;;
            --build-only)    OPT_BUILD_ONLY=true ;;
            --post-build-only) OPT_POST_BUILD_ONLY=true ;;
            -y|--yes|--quiet) OPT_YES=true ;;
            -h|--help)       usage; exit 0 ;;
            *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
        esac
        shift
    done
    
    # prompt_value <variable_name> <prompt_text> <default>
    # Sets the named variable to user input (or default on Enter / -y mode).
    prompt_value() {
        local -n _pv_ref="$1"
        local prompt="$2"
        local default="$3"
        if [[ "$OPT_YES" == true ]]; then
            _pv_ref="$default"
            info "${prompt}: ${default} (auto)"
        else
            read -rp "  ${prompt} [${default}]: " _pv_ref
            _pv_ref="${_pv_ref:-$default}"
        fi
    }
    
    # prompt_yn <question> <default: true|false>  → 0=yes, 1=no
    prompt_yn() {
        local question="$1"
        local default="${2:-false}"
        local answer
        if [[ "$OPT_YES" == true ]]; then
            [[ "$default" == true ]]; return
        fi
        if [[ "$default" == true ]]; then
            read -rp "  ${question} [Y/n]: " answer
            answer="${answer:-y}"
        else
            read -rp "  ${question} [y/N]: " answer
            answer="${answer:-n}"
        fi
        [[ "${answer,,}" =~ ^y ]]
    }

# package_checklist <result_nameref> <current_skip_list>
# Shows an interactive whiptail checklist of all workspace packages.
# The user marks which ones to BUILD; unchecked = skipped.
# waywiser and waywiser_core are always built and not shown in the checklist.
package_checklist() {
    local -n _pc_ref="$1"
    local cur_skip="$2"

    # Packages that are always built — excluded from the checklist entirely.
    local -r LOCKED="waywiser waywiser_core waywiser_description waywiser_twist_safety"

    # Enumerate packages from package.xml files in the repo (skip external/ and .git/)
    local all_pkgs=()
    while IFS= read -r name; do
        [[ -n "$name" ]] && all_pkgs+=("$name")
    done < <(find "$REPO_DIR" -name "package.xml" \
        ! -path "*/external/*" ! -path "*/.git/*" \
        -exec grep -m1 '<name>' {} \; \
        | sed 's|.*<name>||;s|</name>.*||' | sort)

    # Only show non-locked packages in the UI.
    local pkgs=()
    for p in "${all_pkgs[@]}"; do
        [[ " $LOCKED " == *" $p "* ]] || pkgs+=("$p")
    done

    if [[ ${#pkgs[@]} -eq 0 ]]; then
        warn "No selectable packages found in $REPO_DIR — skipping package selection."
        _pc_ref="$cur_skip"
        return
    fi

    if [[ "$OPT_YES" == true ]]; then
        _pc_ref="$cur_skip"
        return
    fi

    # Build reverse-dependency map: rev_deps[pkg]="space-separated list of workspace
    # packages that declare a dependency on pkg".
    local pkg_list_str=" ${all_pkgs[*]} "
    declare -A rev_deps
    while IFS= read -r xml; do
        local depender
        depender=$(grep -m1 '<name>' "$xml" | sed 's|.*<name>||;s|</name>.*||')
        while IFS= read -r dep; do
            [[ "$pkg_list_str" == *" $dep "* ]] || continue  # workspace packages only
            rev_deps["$dep"]+="$depender "
        done < <(grep -E '<(depend|build_depend|exec_depend|run_depend)>' "$xml" \
                 | sed 's|^[[:space:]]*<[^>]*>||;s|</[^>]*>.*||' | sort -u)
    done < <(find "$REPO_DIR" -name "package.xml" \
        ! -path "*/external/*" ! -path "*/.git/*")

    if command -v whiptail &>/dev/null && [[ -t 1 ]]; then
        # Build the "always built" bullet list for the dialog message.
        local locked_lines=""
        for pkg in $LOCKED; do
            [[ " ${all_pkgs[*]} " == *" $pkg "* ]] || continue
            locked_lines+="  * $pkg"$'\n'
        done

        local items=()
        for pkg in "${pkgs[@]}"; do
            local state="ON"
            [[ " $cur_skip " == *" $pkg "* ]] && state="OFF"
            local desc=""
            local rdeps="${rev_deps[$pkg]:-}"
            [[ -n "$rdeps" ]] && desc="[needed by: ${rdeps% }]"
            items+=("$pkg" "$desc" "$state")
        done
        local n=${#pkgs[@]}
        local height=$(( n + 12 ))
        (( height > 34 )) && height=34
        local width=$(( $(tput cols 2>/dev/null || echo 80) - 4 ))
        (( width < 60 )) && width=60
        local result exit_status=0
        result=$(whiptail \
            --title "WayWiseR — Build Packages" \
            --checklist \
"Always built (cannot be skipped):
${locked_lines}
Check packages to BUILD (uncheck to skip).
(Space = toggle  |  Arrow keys = navigate  |  Enter = confirm)" \
            "$height" "$width" "$n" \
            "${items[@]}" \
            3>&1 1>&2 2>&3) || exit_status=$?
        if [[ $exit_status -ne 0 ]]; then return 1; fi  # Cancel/Esc → abort
        local selected
        selected=$(echo "$result" | tr -d '"')
        # Build new skip list from packages the user did not select.
        local new_skip=()
        for pkg in "${pkgs[@]}"; do
            [[ " $selected " == *" $pkg "* ]] || new_skip+=("$pkg")
        done
        _pc_ref="${new_skip[*]:-}"
    else
        # Fallback: y/n per package
        local _skip=()
        echo "  Always built (cannot be skipped):"
        for pkg in $LOCKED; do
            [[ " ${all_pkgs[*]} " == *" $pkg "* ]] || continue
            echo "    * $pkg"
        done
        echo
        echo "  Select packages to build (answer n to skip):"
        for pkg in "${pkgs[@]}"; do
            local def=true
            [[ " $cur_skip " == *" $pkg "* ]] && def=false
            local rdeps="${rev_deps[$pkg]:-}"
            local hint=""
            [[ -n "$rdeps" ]] && hint=" [needed by: ${rdeps% }]"
            prompt_yn "  Build $pkg?$hint" "$def" || _skip+=("$pkg")
        done
        _pc_ref="${_skip[*]:-}"
    fi
}

    # ── step 1: system prerequisites ─────────────────────────────────────────────
    
    install_apt_deps() {
        header "Installing system apt dependencies"
        local -a _apt_packages=(
            ccache
            gnupg
            git
            build-essential
            cmake
            python3-colcon-common-extensions
            python3-dev
            curl
            software-properties-common
        )
        local -a _missing=()
        local _pkg
        for _pkg in "${_apt_packages[@]}"; do
            dpkg -s "$_pkg" &>/dev/null || _missing+=("$_pkg")
        done
        if [[ ${#_missing[@]} -eq 0 ]]; then
            info "All apt packages already installed — skipping."
            return 0
        fi
        info "Packages to install: ${_missing[*]}"
        prompt_yn "Install missing apt packages (sudo apt-get install)?" true \
            || { info "Skipping apt dependencies."; return 0; }
        as_root apt-get update -qq
        as_root apt-get install $(yes_args -y) "${_missing[@]}"
        info "apt packages installed."
    }

    install_gazebo_harmonic_deps() {
        header "Configuring PX4/Gazebo Harmonic apt repository"
        local keyring="/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg"
        local sources_list="/etc/apt/sources.list.d/gazebo-stable.list"

        if [[ ! -f "$keyring" || ! -f "$sources_list" ]]; then
            prompt_yn "Add OSRF Gazebo apt repository?" true \
                || { info "Skipping PX4/Gazebo Harmonic dependencies."; return 0; }
            as_root curl -fsSL https://packages.osrfoundation.org/gazebo.gpg \
                -o "$keyring"
            local ubuntu_codename
            ubuntu_codename=$(. /etc/os-release && echo "$UBUNTU_CODENAME")
            echo "deb [arch=$(dpkg --print-architecture) signed-by=$keyring] http://packages.osrfoundation.org/gazebo/ubuntu-stable $ubuntu_codename main" \
                | as_root tee "$sources_list" > /dev/null
            as_root apt-get update -qq
            info "OSRF Gazebo apt repository added. rosdep will install Gazebo packages."
        else
            info "OSRF Gazebo apt repository already configured."
        fi
    }

    should_install_gazebo_harmonic_deps() {
        local arch skipped

        arch=$(dpkg --print-architecture 2>/dev/null || uname -m)
        [[ "$arch" == "amd64" ]] || return 1

        ensure_env_file
        skipped=$(env_get WAYWISER_SKIPPED_PACKAGES)
        [[ " $skipped " != *" waywiser_gazebo "* ]]
    }
    
    install_uv() {
        if command -v uv &>/dev/null; then
            info "uv already installed: $(uv --version)"
            return 0
        fi
        header "Installing uv (Python package manager)"
        prompt_yn "Install uv via curl | sh?" true \
            || die "uv is required. Install it manually: https://github.com/astral-sh/uv"
        curl -LsSf https://astral.sh/uv/install.sh | sh
        # Make uv available in this shell session
        export PATH="$HOME/.local/bin:$PATH"
        command -v uv &>/dev/null \
        || die "uv installation failed — please install manually: https://github.com/astral-sh/uv"
        info "uv installed: $(uv --version)"
    }
    
    setup_ros2_environment() {
        header "Checking ROS2 environment"
        ensure_ros2_environment
    }
    
    install_mavsdk() {
        # Only install if libmavsdk-dev is missing; don't touch an existing install.
        if dpkg -s libmavsdk-dev &>/dev/null; then
            local ver; ver=$(dpkg -s libmavsdk-dev | awk '/^Version:/{print $2}')
            info "MAVSDK already installed: ${ver}"
            return 0
        fi
        header "Installing MAVSDK 2.x"
        local arch; arch=$(dpkg --print-architecture)
        local arch_var="MAVSDK_${arch^^}_DEB_URL"
        arch_var="${arch_var//-/_}"
        local mavsdk_release_version="${MAVSDK_VERSION_DEFAULT:-2.14.1}"
        local mavsdk_deb_url="${MAVSDK_DEB_URL:-${!arch_var:-}}"
        local mavsdk_deb_path="${MAVSDK_DEB_PATH:-}"

        if [[ -z "$mavsdk_deb_url" ]]; then
            case "$arch" in
                amd64)
                    mavsdk_deb_url="https://github.com/mavlink/MAVSDK/releases/download/v${mavsdk_release_version}/libmavsdk-dev_${mavsdk_release_version}_ubuntu22.04_amd64.deb"
                    ;;
                arm64)
                    mavsdk_deb_url="https://github.com/mavlink/MAVSDK/releases/download/v${mavsdk_release_version}/libmavsdk-dev_${mavsdk_release_version}_debian11_arm64.deb"
                    ;;
            esac
        fi

        if [[ -n "$mavsdk_deb_path" ]]; then
            [[ -f "$mavsdk_deb_path" ]] || die "MAVSDK_DEB_PATH does not exist: $mavsdk_deb_path"
            info "Installing MAVSDK from local deb: $mavsdk_deb_path"
            as_root dpkg -i "$mavsdk_deb_path"
            info "MAVSDK installed."
            return 0
        fi

        if [[ -n "$mavsdk_deb_url" ]]; then
            local tmp_deb; tmp_deb=$(mktemp --suffix=.deb)
            info "Downloading MAVSDK for $arch: $mavsdk_deb_url"
            curl -LsSf "$mavsdk_deb_url" -o "$tmp_deb"
            as_root dpkg -i "$tmp_deb"
            rm -f "$tmp_deb"
            info "MAVSDK installed."
            return 0
        fi

        local mavsdk_build_script="$REPO_DIR/waywiser/scripts/build_mavsdk_deb.sh"
        if [[ -x "$mavsdk_build_script" \
            && "${WAYWISER_BUILD_MAVSDK_DEB:-false}" == "true" ]]; then
            local built_deb
            prompt_yn "Build and install MAVSDK deb for $arch from WayWise tools?" true \
                || { info "Skipping MAVSDK build."; MAVSDK_MANUAL_INSTALL=true; return 0; }
            built_deb="$(
                MAVSDK_DEB_OUT="${WAYWISER_MAVSDK_DEB_OUT:-$WAYWISER_WS/deb_stage/$arch}" \
                "$mavsdk_build_script" "$arch" | tail -n 1
            )"
            [[ -f "$built_deb" ]] || die "MAVSDK build did not produce a deb: $built_deb"
            info "Installing MAVSDK from built deb: $built_deb"
            as_root dpkg -i "$built_deb"
            info "MAVSDK installed."
            return 0
        fi

        # Default amd64 release package for Ubuntu 22.04; other arches require a
        # local build or an explicit MAVSDK_DEB_URL/MAVSDK_DEB_PATH.
        local MAVSDK_AMD64_URL="https://github.com/mavlink/MAVSDK/releases/download/v${mavsdk_release_version}/libmavsdk-dev_${mavsdk_release_version}_ubuntu22.04_amd64.deb"
        if [[ "$arch" != "amd64" ]]; then
            MAVSDK_MANUAL_INSTALL=true
            warn "MAVSDK auto-install is only supported for amd64 unless MAVSDK_DEB_URL or MAVSDK_DEB_PATH is set."
            return 0
        fi
        local tmp_deb; tmp_deb=$(mktemp --suffix=.deb)
        prompt_yn "Install MAVSDK 2.x via dpkg -i (downloads ~10 MB)?" true \
            || { info "Skipping MAVSDK install."; MAVSDK_MANUAL_INSTALL=true; return 0; }
        info "Downloading: $MAVSDK_AMD64_URL"
        curl -LsSf "$MAVSDK_AMD64_URL" -o "$tmp_deb"
        as_root dpkg -i "$tmp_deb"
        rm -f "$tmp_deb"
        info "MAVSDK installed."
    }

init_rosdep() {
    if [[ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]]; then
        as_root rosdep init
    fi
    local waywiser_rosdep_source="/etc/ros/rosdep/sources.list.d/50-waywiser.list"
    local waywiser_rosdep_yaml="$REPO_DIR/waywiser/rosdep/waywiser.yaml"
    if [[ -f "$waywiser_rosdep_yaml" ]]; then
        local source_line="yaml file://$waywiser_rosdep_yaml"
        if [[ ! -f "$waywiser_rosdep_source" ]] \
            || ! grep -qxF "$source_line" "$waywiser_rosdep_source"; then
            echo "$source_line" | as_root tee "$waywiser_rosdep_source" > /dev/null
            info "Registered WayWiseR rosdep rules: $waywiser_rosdep_yaml"
        fi
    fi
    rosdep update --rosdistro "${ROS_DISTRO:-humble}"
}

check_prerequisites() {
    install_apt_deps
    if should_install_gazebo_harmonic_deps; then
        install_gazebo_harmonic_deps
    else
        info "Skipping PX4/Gazebo Harmonic apt repository; waywiser_gazebo is not selected for this architecture."
    fi
    install_uv
    setup_ros2_environment
    if [[ "$OPT_SKIP_MAVSDK" != true ]]; then
        install_mavsdk
    fi
    init_rosdep
}

