# Use the official ROS Humble Desktop image as the base.
FROM osrf/ros:humble-desktop

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH=/root/.local/bin:${PATH}
ENV WAYWISER_CI_VENV=/opt/waywiser-ci-venv

RUN apt-get update && apt-get install -y \
    build-essential \
    ccache \
    cmake \
    curl \
    git \
    libqt5serialport5-dev \
    libunwind-dev \
    python3-colcon-common-extensions \
    python3-colcon-coveragepy-result \
    python3-colcon-lcov-result \
    python3-pip \
    software-properties-common \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js v20 from NodeSource for modern GitHub Actions tooling.
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get update && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install uv because the Makefile/bootstrap flow uses it for the workspace venv.
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Pre-install MAVSDK to match the bootstrap path used in CI.
RUN wget https://github.com/mavlink/MAVSDK/releases/download/v2.14.1/libmavsdk-dev_2.14.1_ubuntu22.04_amd64.deb \
    && dpkg --install libmavsdk-dev_2.14.1_ubuntu22.04_amd64.deb \
    && rm libmavsdk-dev_2.14.1_ubuntu22.04_amd64.deb

ENV CCACHE_DIR=/root/.ccache
RUN ccache -M 2G

RUN rosdep init || true
RUN rosdep update --rosdistro humble

# Warm the image using the same Makefile/bootstrap path that GitHub Actions runs.
RUN mkdir -p /tmp/ws/src
WORKDIR /tmp/ws/src
RUN git clone --branch humble --recursive https://github.com/das-rise/WayWiseR.git

WORKDIR /tmp/ws/src/WayWiseR
COPY pyproject.toml uv.lock .python-version README.md ./
RUN uv venv --python "$(cat .python-version)" "$WAYWISER_CI_VENV" \
    && . "$WAYWISER_CI_VENV/bin/activate" \
    && uv pip install -e ".[build,waywiser_test_runner]"

RUN if make -qp 2>/dev/null | grep -q '^setup:'; then \
        CI=true WAYWISER_SKIPPED_PACKAGES="" make setup ARGS="--quiet --skip-prereqs --skip-mavsdk"; \
    else \
        apt-get update \
        && rosdep install --from-paths /tmp/ws/src -i -y --rosdistro humble \
            --skip-keys "px4_msgs carla_msgs carla_spawn_objects carla_ros_bridge" \
        && rm -rf /var/lib/apt/lists/*; \
    fi

WORKDIR /
RUN rm -rf /tmp/ws

CMD ["/bin/bash"]
