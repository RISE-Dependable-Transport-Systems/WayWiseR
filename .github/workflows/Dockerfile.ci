# Use the official ROS Humble Desktop image as the base
FROM osrf/ros:humble-desktop

# Avoid interactive prompts during apt-get
ENV DEBIAN_FRONTEND=noninteractive

# Update and install basic utilities
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    python3-pip \
    python3-vcstool \
    build-essential \
    cmake \
    ccache \
    python3-colcon-common-extensions \
    python3-colcon-lcov-result \
    python3-colcon-coveragepy-result \
    libunwind-dev \
    libqt5serialport5-dev \
    python3-pyqt5 \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js v20 from NodeSource (required for modern GitHub Actions)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs

# Pre-install MAVSDK v2.2.0
RUN wget https://github.com/mavlink/MAVSDK/releases/download/v2.2.0/libmavsdk-dev_2.2.0_ubuntu22.04_amd64.deb \
    && dpkg --install libmavsdk-dev_2.2.0_ubuntu22.04_amd64.deb \
    && rm libmavsdk-dev_2.2.0_ubuntu22.04_amd64.deb

# Setup ccache for the root user (used by GitHub Actions)
ENV CCACHE_DIR=/root/.ccache
RUN ccache -M 2G

# Initialize and update rosdep
RUN rosdep update

# Pre-install project and external dependencies
# 1. Setup workspace and clone all repositories (WayWiseR + carla-ros-bridge)
RUN mkdir -p /tmp/ws/src && \
    printf "repositories:\n  WayWiseR:\n    type: git\n    url: https://github.com/das-rise/WayWiseR.git\n    version: humble\n  carla_ros_bridge:\n    type: git\n    url: https://github.com/das-rise/carla-ros-bridge.git\n    version: v0.9.15-humble-dev" > /tmp/ws/deps.repos && \
    vcs import /tmp/ws/src < /tmp/ws/deps.repos

# 2. Recursive submodule update for project and external repos
RUN cd /tmp/ws/src/WayWiseR && git submodule update --init --recursive && \
    cd /tmp/ws/src/carla_ros_bridge && git submodule update --init --recursive

# 3. Use rosdep to install everything
RUN apt-get update && \
    rosdep install --from-paths /tmp/ws/src -i -y --rosdistro humble && \
    rm -rf /tmp/ws && \
    rm -rf /var/lib/apt/lists/*

# Set the entrypoint to a shell by default
CMD ["/bin/bash"]
