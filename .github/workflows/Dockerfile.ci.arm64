# syntax=docker/dockerfile:1.4
ARG ROS_DISTRO=jazzy
ARG WAYWISER_REF=experimental/jazzy
ARG WAYWISER_SKIPPED_PACKAGES="waywiser_agrarsense waywiser_carla waywiser_gazebo waywiser_rviz2 waywiser_teleop"
ARG ACT_COMPAT=false

# osrf/ros:${ROS_DISTRO}-desktop is amd64-only, which makes Buildx fall back to
# an amd64 rootfs during arm64 image builds. Use the official multi-arch ROS
# image instead; Buildx selects the arm64 variant from --platform linux/arm64.
FROM ros:${ROS_DISTRO}-ros-base-jammy

SHELL ["/bin/bash", "-c"]

ARG ROS_DISTRO
ARG WAYWISER_REF
ARG WAYWISER_SKIPPED_PACKAGES
ARG ACT_COMPAT
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=${ROS_DISTRO}
ENV WAYWISER_VENV_PATH=/opt/waywiser-ci-venv
ENV WAYWISER_REUSE_VENV=true
ENV WAYWISER_CMAKE_ARGS="-U_lib -U*_LIBRARY -U*_LIBRARIES"
ENV UV_HTTP_TIMEOUT=600
ENV UV_CONCURRENT_DOWNLOADS=4
ENV WAYWISER_SKIPPED_PACKAGES=${WAYWISER_SKIPPED_PACKAGES}
ENV WAYWISER_USER=waywiser
ENV WAYWISER_UNDERLAY_WS=/home/waywiser/workspaces/waywiser_ws
ENV WAYWISER_UNDERLAY_SETUP=/home/waywiser/workspaces/waywiser_ws/install/setup.bash

RUN [[ "$TARGETARCH" == "arm64" ]] \
    && [[ "$(dpkg --print-architecture)" == "arm64" ]]

RUN apt-get update && apt-get install -y \
    curl \
    git \
    make \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js v20 from NodeSource for modern GitHub Actions tooling.
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get update && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# act copies workflow runtime files into /var/run/act. Local image builds can
# opt into this compatibility path without changing the GitHub Actions image.
RUN if [[ "$ACT_COMPAT" == "true" ]] && [[ -L /var/run ]]; then \
        rm /var/run; \
    fi \
    && if [[ "$ACT_COMPAT" == "true" ]]; then \
        mkdir -p /var/run/act; \
    fi

RUN useradd --create-home --shell /bin/bash "$WAYWISER_USER" \
    && mkdir -p /home/waywiser/workspaces \
    && chown -R "$WAYWISER_USER:$WAYWISER_USER" /home/waywiser/workspaces

ENV CCACHE_DIR=/opt/ccache
RUN mkdir -p /opt/ccache && chmod 777 /opt/ccache

# Build a reusable WayWiseR underlay for arm64 packaging. Simulation packages
# that are skipped by package-arm64 are also skipped in this image by default.
RUN mkdir -p "$WAYWISER_UNDERLAY_WS/src"
RUN git clone --branch "$WAYWISER_REF" https://github.com/das-rise/WayWiseR.git "$WAYWISER_UNDERLAY_WS/src/WayWiseR" \
    && if [[ -f "$WAYWISER_UNDERLAY_WS/src/WayWiseR/Makefile" ]]; then \
        ln -s "$WAYWISER_UNDERLAY_WS/src/WayWiseR/Makefile" "$WAYWISER_UNDERLAY_WS/Makefile"; \
    fi

WORKDIR $WAYWISER_UNDERLAY_WS

RUN BOOTSTRAP_PATH=""; \
    if [[ -f waywiser/scripts/bootstrap ]]; then BOOTSTRAP_PATH=waywiser/scripts/bootstrap; elif [[ -f src/WayWiseR/waywiser/scripts/bootstrap ]]; then BOOTSTRAP_PATH=src/WayWiseR/waywiser/scripts/bootstrap; elif [[ -f bootstrap ]]; then BOOTSTRAP_PATH=bootstrap; fi; \
    [[ -f Makefile && -n "$BOOTSTRAP_PATH" ]] || { echo "WayWiseR Makefile/bootstrap not found in $PWD" >&2; exit 1; }; \
    echo "Using WayWiseR Makefile/bootstrap flow from $WAYWISER_REF for arm64." \
    && CI=true WAYWISER_WS="$WAYWISER_UNDERLAY_WS" \
        make setup ARGS="--quiet"

# Workspace root and build outputs need write access. Leave the venv root-owned:
# recursively chowning site-packages is slow and can exhaust Docker overlay space.
# We do chown the venv activate script so setup_activate_hook can append to it.
#
# The bootstrap .env fallback is /etc/waywiser/waywiser.env (system path, root-
# owned) when src/WayWiseR/.env does not exist. Copy it to the canonical repo
# location so the non-root build user can write to it without sudo.
RUN mkdir -p "$WAYWISER_UNDERLAY_WS/build" "$WAYWISER_UNDERLAY_WS/install" "$WAYWISER_UNDERLAY_WS/log" \
    && chown "$WAYWISER_USER:$WAYWISER_USER" \
        "$WAYWISER_UNDERLAY_WS" \
        "$WAYWISER_UNDERLAY_WS/build" \
        "$WAYWISER_UNDERLAY_WS/install" \
    && chown -R "$WAYWISER_USER:$WAYWISER_USER" "$WAYWISER_UNDERLAY_WS/src/WayWiseR" \
    && chown -R "$WAYWISER_USER:$WAYWISER_USER" "$WAYWISER_UNDERLAY_WS/log" \
    && if [[ ! -f "$WAYWISER_UNDERLAY_WS/src/WayWiseR/.env" ]]; then \
        if [[ -f /etc/waywiser/waywiser.env ]]; then \
            cp /etc/waywiser/waywiser.env "$WAYWISER_UNDERLAY_WS/src/WayWiseR/.env"; \
        else \
            cp "$WAYWISER_UNDERLAY_WS/src/WayWiseR/.env.example" "$WAYWISER_UNDERLAY_WS/src/WayWiseR/.env"; \
        fi; \
    fi \
    && chown "$WAYWISER_USER:$WAYWISER_USER" "$WAYWISER_UNDERLAY_WS/src/WayWiseR/.env" \
    && if [[ -f "$WAYWISER_VENV_PATH/bin/activate" ]]; then \
        chown "$WAYWISER_USER:$WAYWISER_USER" "$WAYWISER_VENV_PATH/bin/activate"; \
    fi

RUN mv /usr/bin/colcon /usr/bin/colcon.real \
    && printf '%s\n' \
        '#!/usr/bin/env bash' \
        'set -euo pipefail' \
        'if [[ "${1:-}" == "build" ]]; then' \
        '    for arg in "$@"; do' \
        '        [[ "$arg" == "--help" || "$arg" == "-h" ]] && exec /usr/bin/colcon.real "$@"' \
        '    done' \
        '    exec /usr/bin/colcon.real "$@" --cmake-args -U_lib "-U*_LIBRARY" "-U*_LIBRARIES"' \
        'fi' \
        'exec /usr/bin/colcon.real "$@"' \
        > /usr/bin/colcon \
    && chmod 0755 /usr/bin/colcon

RUN mv /usr/bin/colcon /usr/bin/colcon.real \
    && printf '%s\n' \
        '#!/usr/bin/env bash' \
        'set -euo pipefail' \
        'if [[ "${1:-}" == "build" ]]; then' \
        '    for arg in "$@"; do' \
        '        [[ "$arg" == "--help" || "$arg" == "-h" ]] && exec /usr/bin/colcon.real "$@"' \
        '    done' \
        '    exec /usr/bin/colcon.real "$@" --cmake-args -U_lib "-U*_LIBRARY" "-U*_LIBRARIES"' \
        'fi' \
        'exec /usr/bin/colcon.real "$@"' \
        > /usr/bin/colcon \
    && chmod 0755 /usr/bin/colcon

USER $WAYWISER_USER

RUN BOOTSTRAP_PATH=""; \
    if [[ -f waywiser/scripts/bootstrap ]]; then BOOTSTRAP_PATH=waywiser/scripts/bootstrap; elif [[ -f src/WayWiseR/waywiser/scripts/bootstrap ]]; then BOOTSTRAP_PATH=src/WayWiseR/waywiser/scripts/bootstrap; elif [[ -f bootstrap ]]; then BOOTSTRAP_PATH=bootstrap; fi; \
    [[ -f Makefile && -n "$BOOTSTRAP_PATH" ]] || { echo "WayWiseR Makefile/bootstrap not found in $PWD" >&2; exit 1; }; \
    echo "Building underlay with WayWiseR Makefile/bootstrap flow from $WAYWISER_REF for arm64." \
    && CI=true WAYWISER_WS="$WAYWISER_UNDERLAY_WS" WAYWISER_UNDERLAY_SETUP="" \
        make build ARGS="--quiet"

RUN if [[ -f "$WAYWISER_UNDERLAY_WS/.venv/bin/activate" ]] \
        && ! grep -q "WayWiseR Environment Setup" "$WAYWISER_UNDERLAY_WS/.venv/bin/activate" 2>/dev/null; then \
        { echo ''; \
          echo '# WayWiseR Environment Setup'; \
          echo "source /opt/ros/${ROS_DISTRO}/setup.bash"; \
          echo "export WAYWISER_WS=$WAYWISER_UNDERLAY_WS"; \
          echo "export WAYWISER_SKIPPED_PACKAGES=''"; \
          echo "export PYTHONPATH=$WAYWISER_VENV_PATH/lib/python\$(python3 --version 2>&1 | awk '{print \$2}' | cut -d. -f1,2)/site-packages:\$PYTHONPATH"; \
          echo ''; \
          echo "if [ -f \"$WAYWISER_UNDERLAY_WS/install/setup.bash\" ]; then"; \
          echo "  source \"$WAYWISER_UNDERLAY_WS/install/setup.bash\""; \
          echo 'fi'; \
        } >> "$WAYWISER_UNDERLAY_WS/.venv/bin/activate"; \
    fi

CMD ["/bin/bash"]
