ARG ROS_DISTRO=humble
ARG WAYWISER_REF=humble
ARG WAYWISER_SKIPPED_PACKAGES="waywiser_agrarsense waywiser_carla waywiser_gazebo waywiser_rviz2 waywiser_teleop"
ARG ACT_COMPAT=false

# osrf/ros:${ROS_DISTRO}-desktop is amd64-only, which makes Buildx fall back to
# an amd64 rootfs during arm64 image builds. Use the official multi-arch ROS
# image instead; Buildx selects the arm64 variant from --platform linux/arm64.
FROM ros:${ROS_DISTRO}-ros-base-jammy

SHELL ["/bin/bash", "-c"]

ARG ROS_DISTRO
ARG WAYWISER_REF
ARG WAYWISER_SKIPPED_PACKAGES
ARG ACT_COMPAT
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=${ROS_DISTRO}
ENV WAYWISER_VENV_PATH=/opt/waywiser-ci-venv
ENV WAYWISER_REUSE_VENV=true
ENV WAYWISER_SKIPPED_PACKAGES=${WAYWISER_SKIPPED_PACKAGES}
ENV WAYWISER_USER=waywiser
ENV WAYWISER_UNDERLAY_WS=/home/waywiser/workspaces/waywiser_ws
ENV WAYWISER_UNDERLAY_SETUP=/home/waywiser/workspaces/waywiser_ws/install/setup.bash

RUN [[ "$TARGETARCH" == "arm64" ]] \
    && [[ "$(dpkg --print-architecture)" == "arm64" ]]

RUN apt-get update && apt-get install -y \
    curl \
    git \
    make \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js v20 from NodeSource for modern GitHub Actions tooling.
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get update && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# act copies workflow runtime files into /var/run/act. Local image builds can
# opt into this compatibility path without changing the GitHub Actions image.
RUN if [[ "$ACT_COMPAT" == "true" ]] && [[ -L /var/run ]]; then \
        rm /var/run; \
    fi \
    && if [[ "$ACT_COMPAT" == "true" ]]; then \
        mkdir -p /var/run/act; \
    fi

RUN useradd --create-home --shell /bin/bash "$WAYWISER_USER" \
    && mkdir -p /home/waywiser/workspaces \
    && chown -R "$WAYWISER_USER:$WAYWISER_USER" /home/waywiser/workspaces

ENV CCACHE_DIR=/opt/ccache
RUN mkdir -p /opt/ccache && chmod 777 /opt/ccache

# Build a reusable WayWiseR underlay for arm64 packaging. Simulation packages
# that are skipped by package-arm64 are also skipped in this image by default.
RUN mkdir -p "$WAYWISER_UNDERLAY_WS/src"
RUN git clone --branch "$WAYWISER_REF" --recursive https://github.com/das-rise/WayWiseR.git $WAYWISER_UNDERLAY_WS/src/WayWiseR

WORKDIR $WAYWISER_UNDERLAY_WS

RUN BOOTSTRAP_PATH=""; \
    if [[ -f waywiser/scripts/bootstrap ]]; then BOOTSTRAP_PATH=waywiser/scripts/bootstrap; elif [[ -f bootstrap ]]; then BOOTSTRAP_PATH=bootstrap; fi; \
    if [[ -f Makefile && -n "$BOOTSTRAP_PATH" ]] && grep -q 'base_paths+=.*carla-ros-bridge' "$BOOTSTRAP_PATH"; then \
        echo "Using WayWiseR Makefile/bootstrap flow from $WAYWISER_REF for arm64."; \
        CI=true WAYWISER_WS="$WAYWISER_UNDERLAY_WS" \
            make setup ARGS="--quiet"; \
    else \
        echo "Using conventional colcon fallback for $WAYWISER_REF on arm64."; \
        apt-get update \
        && apt-get install -y \
            build-essential \
            ccache \
            cmake \
            dpkg-dev \
            fakeroot \
            gnupg \
            libqt5serialport5-dev \
            libssl-dev \
            libunwind-dev \
            python3-colcon-common-extensions \
            python3-colcon-coveragepy-result \
            python3-colcon-lcov-result \
            python3-pip \
            software-properties-common \
            wget \
        && rm -rf /var/lib/apt/lists/* \
        && curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR=/usr/local/bin sh \
        && wget https://github.com/mavlink/MAVSDK/releases/download/v2.14.1/libmavsdk-dev_2.14.1_debian11_arm64.deb \
        && dpkg --install libmavsdk-dev_2.14.1_debian11_arm64.deb \
        && rm libmavsdk-dev_2.14.1_debian11_arm64.deb \
        && ccache -M 2G \
        && (rosdep init || true) \
        && rosdep update --rosdistro "$ROS_DISTRO" \
        && apt-get update \
        && read -r -a SKIPPED_PACKAGE_ARGS <<< "$WAYWISER_SKIPPED_PACKAGES" \
        && ROSDEP_BASE_PATHS=("$WAYWISER_UNDERLAY_WS/src") \
        && if [[ ${#SKIPPED_PACKAGE_ARGS[@]} -gt 0 ]]; then \
            mapfile -t ROSDEP_PATHS < <(colcon list --base-paths "${ROSDEP_BASE_PATHS[@]}" --packages-skip "${SKIPPED_PACKAGE_ARGS[@]}" --paths-only); \
        else \
            mapfile -t ROSDEP_PATHS < <(colcon list --base-paths "${ROSDEP_BASE_PATHS[@]}" --paths-only); \
        fi \
        && rosdep install --from-paths "${ROSDEP_PATHS[@]}" -i -y --rosdistro "$ROS_DISTRO" \
            --skip-keys "px4_msgs carla_msgs carla_spawn_objects carla_ros_bridge" \
        && rm -rf /var/lib/apt/lists/*; \
    fi

# Workspace root: waywiser needs write access to create build/, install/, log/.
# Venv: only chown if make setup already created it (Makefile path).
RUN mkdir -p "$WAYWISER_UNDERLAY_WS/build" "$WAYWISER_UNDERLAY_WS/install" "$WAYWISER_UNDERLAY_WS/log" \
    && chown -R "$WAYWISER_USER:$WAYWISER_USER" "$WAYWISER_UNDERLAY_WS" \
    && if [[ -d "$WAYWISER_VENV_PATH" ]]; then \
        chown -R "$WAYWISER_USER:$WAYWISER_USER" "$WAYWISER_VENV_PATH"; \
    else \
        mkdir -p "$WAYWISER_VENV_PATH" \
        && chown "$WAYWISER_USER:$WAYWISER_USER" "$WAYWISER_VENV_PATH"; \
    fi

USER $WAYWISER_USER

# Colcon fallback only: create the venv and install Python dependencies as
# waywiser so ownership is correct from the start. uv was installed system-wide
# (/usr/local/bin) during setup so it is accessible to this user.
RUN BOOTSTRAP_PATH=""; \
    if [[ -f waywiser/scripts/bootstrap ]]; then BOOTSTRAP_PATH=waywiser/scripts/bootstrap; elif [[ -f bootstrap ]]; then BOOTSTRAP_PATH=bootstrap; fi; \
    if ! ([[ -f Makefile && -n "$BOOTSTRAP_PATH" ]] && grep -q 'base_paths+=.*carla-ros-bridge' "$BOOTSTRAP_PATH"); then \
    uv venv --python "$(cat $WAYWISER_UNDERLAY_WS/src/WayWiseR/.python-version)" "$WAYWISER_VENV_PATH" \
    && . "$WAYWISER_VENV_PATH/bin/activate" \
    && uv pip install \
        catkin-pkg \
        empy==3.3.2 \
        jinja2 \
        lark \
        psutil \
        python-dotenv \
        pyyaml \
        setuptools==58.2.0 \
    && uv pip install --no-deps -e "$WAYWISER_UNDERLAY_WS/src/WayWiseR"; \
fi

RUN BOOTSTRAP_PATH=""; \
    if [[ -f waywiser/scripts/bootstrap ]]; then BOOTSTRAP_PATH=waywiser/scripts/bootstrap; elif [[ -f bootstrap ]]; then BOOTSTRAP_PATH=bootstrap; fi; \
    if [[ -f Makefile && -n "$BOOTSTRAP_PATH" ]] && grep -q 'base_paths+=.*carla-ros-bridge' "$BOOTSTRAP_PATH"; then \
        echo "Building underlay with WayWiseR Makefile/bootstrap flow from $WAYWISER_REF for arm64."; \
        CI=true WAYWISER_WS="$WAYWISER_UNDERLAY_WS" WAYWISER_UNDERLAY_SETUP="" \
            make build ARGS="--quiet"; \
    else \
        echo "Building underlay with colcon for $WAYWISER_REF on arm64."; \
        read -r -a SKIPPED_PACKAGE_ARGS <<< "$WAYWISER_SKIPPED_PACKAGES"; \
        COLCON_BASE_PATHS=("$WAYWISER_UNDERLAY_WS/src"); \
        . "/opt/ros/$ROS_DISTRO/setup.bash" \
        && . "$WAYWISER_VENV_PATH/bin/activate" \
        && cd "$WAYWISER_UNDERLAY_WS" \
        && colcon build --symlink-install \
            --base-paths "${COLCON_BASE_PATHS[@]}" \
            --packages-skip "${SKIPPED_PACKAGE_ARGS[@]}" \
            --cmake-args --no-warn-unused-cli \
                -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
                -DCMAKE_C_COMPILER_LAUNCHER=ccache \
                -DOPENSSL_ROOT_DIR=/usr \
                -DOPENSSL_CRYPTO_LIBRARY=/usr/lib/aarch64-linux-gnu/libcrypto.so \
                -DOPENSSL_SSL_LIBRARY=/usr/lib/aarch64-linux-gnu/libssl.so; \
    fi

RUN if [[ -f "$WAYWISER_UNDERLAY_WS/.venv/bin/activate" ]]; then \
        { echo ''; \
          echo '# WayWiseR Environment Setup'; \
          echo 'source /opt/ros/humble/setup.bash'; \
          echo "export WAYWISER_WS=$WAYWISER_UNDERLAY_WS"; \
          echo "export WAYWISER_SKIPPED_PACKAGES=$WAYWISER_SKIPPED_PACKAGES"; \
          echo "export PYTHONPATH=$WAYWISER_UNDERLAY_WS/.venv/lib/python3.10/site-packages:\$PYTHONPATH"; \
          echo ''; \
          echo "if [ -f \"$WAYWISER_UNDERLAY_WS/install/setup.bash\" ]; then"; \
          echo "  source \"$WAYWISER_UNDERLAY_WS/install/setup.bash\""; \
          echo 'fi'; \
        } >> "$WAYWISER_UNDERLAY_WS/.venv/bin/activate"; \
    fi

CMD ["/bin/bash"]
