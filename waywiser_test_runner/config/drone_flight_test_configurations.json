{
  "flight_test_configurations": [
    {
      "name": "heartbeat_delay_0p5s",
      "iterations": 3,
      "setup_conditions": {
        "world_name": "forest",
        "reset_all": true,
        "reset_gazebo": true,
        "respawn_entities": [
          "drone"
        ],
        "clear_actuators": true
      },
      "test_profile": {
        "mission": {
          "activation_trigger": {
            "topic": "quadcopter_state",
            "message_type": "waywiser_core/msg/QuadcopterState",
            "field": "state_code",
            "value": [
              "ARMED",
              "IN_FLIGHT",
              "HOVERING"
            ]
          },
          "preplanned_route_filepath": "$WAYWISER_WS/resources/forest.xml"
        },
        "topic_perturbation": {
          "heartbeat": {
            "duration_s": 8.0,
            "start_delay_s": 2.0,
            "activation_trigger": {
              "topic": "mission_status",
              "message_type": "waywiser_core/msg/MissionState",
              "field": "state",
              "value": [
                "FOLLOW_ROUTE_FOLLOWING"
              ]
            },
            "mode": "delay",
            "parameters": {
              "delay_s": 0.5
            }
          }
        }
