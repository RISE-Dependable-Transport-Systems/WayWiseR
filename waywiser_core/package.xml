<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>waywiser_core</name>
  <version>0.0.0</version>

  <description>Package wraps WayWise in a ROS2 node</description>

  <maintainer email="waywiser@ri.se">DAS-RISE</maintainer>

  <license>GPLv3</license>

  <url type="website">https://github.com/das-rise/WayWise</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <build_depend>python3-dev</build_depend>
  <build_depend>waywiser</build_depend>
  <build_depend>waywiser_twist_safety</build_depend>
  <exec_depend>waywiser</exec_depend>
  <exec_depend>waywiser_twist_safety</exec_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>qtbase5-dev</depend>
  <build_depend>libqt5-serialport-dev</build_depend>
  <build_depend>libunwind-dev</build_depend>
  <depend>boost</depend>
  <depend>urdf</depend>
  <depend>px4_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>