diff --git a/src/lib/cdrstream/msg2idl.py b/src/lib/cdrstream/msg2idl.py
index 2b027399079..dbb90a1b760 100644
--- a/src/lib/cdrstream/msg2idl.py
+++ b/src/lib/cdrstream/msg2idl.py
@@ -39,6 +39,32 @@ import sys
 
 from rosidl_adapter.msg import convert_msg_to_idl
 
+
+def strip_comment_verbatim_annotations(idl_file):
+    lines = idl_file.read_text().splitlines(keepends=True)
+    stripped_lines = []
+    index = 0
+
+    while index < len(lines):
+        line = lines[index]
+
+        if line.lstrip().startswith('@verbatim') and 'language="comment"' in line:
+            if line.rstrip().endswith(')'):
+                index += 1
+                continue
+
+            index += 1
+            while index < len(lines) and not lines[index].rstrip().endswith(')'):
+                index += 1
+            index += 1
+            continue
+
+        stripped_lines.append(line)
+        index += 1
+
+    idl_file.write_text(''.join(stripped_lines))
+
+
 if __name__ == '__main__':
     parser = argparse.ArgumentParser(
         description=f'Convert px4 .msg files to .idl')
@@ -55,3 +81,4 @@ if __name__ == '__main__':
             package_dir, 'px4_msgs',
             interface_file.absolute().relative_to(package_dir),
             interface_file.parent)
