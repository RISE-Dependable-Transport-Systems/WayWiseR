<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>waywiser_carla</name>
  <version>0.0.0</version>

  <description>Interface between WayWiser and Carla to control ego vehicle</description>

  <maintainer email="ramana.reddy.avula@ri.se">Ramana Avula</maintainer>
  <maintainer email="ashfaq.farooqui@ri.se">Ashfaq Farooqui</maintainer>

  <license>GPLv3</license>

  <url type="website">https://carla.readthedocs.io/en/latest/</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>topic_tools</depend>
  <depend>rclpy</depend>
  <depend>carla_msgs</depend>
  <depend>tf_transformations</depend>
  <depend>waywiser</depend>
  <depend>cv_bridge</depend>
  <exec_depend>carla_ros_bridge</exec_depend>
  <exec_depend>carla_spawn_objects</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>