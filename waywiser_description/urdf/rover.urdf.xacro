<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover">

    <!-- ros2_control not implemented yet -->
    <xacro:arg name="use_ros2_control" default="false" />
    <xacro:arg name="sim_mode" default="false" />
    <xacro:arg name="frame_prefix" default="/" />
    <xacro:property name="frame_prefix" value="$(arg frame_prefix)" />

    <!-- Robot model without sensors -->
    <xacro:include filename="rover_core.xacro" />

    <!-- Sensors -->
    <xacro:include filename="lidar.xacro" />
    <xacro:include filename="imu.xacro" />
    <!-- <xacro:include filename="camera.xacro" /> -->
    <!-- <xacro:include filename="depth_camera.xacro" /> -->
    <xacro:include filename="realsense_d435i_camera.xacro" />
    <xacro:property name="gps_parent_link" value="chassis_link" />
    <xacro:include filename="gps.xacro" />

    <!-- Controller -->

    <xacro:if value="$(arg use_ros2_control)">
        <xacro:include filename="ros2_control.xacro" />
    </xacro:if>
    <xacro:if value="$(arg sim_mode)">
        <xacro:unless value="$(arg use_ros2_control)">
            <xacro:include filename="gazebo_ackermann_control.xacro" />
        </xacro:unless>
    </xacro:if>
</robot>