    <link name="imu_link">
      <pose>0 0 0.05 0 0 0</pose>
      <sensor name="imu_link" type="imu">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <topic>drone/imu</topic>
        <ignition_frame_id>drone/imu_link</ignition_frame_id>
        <pose relative_to='imu_link'>0 0 0 0 0 0</pose>
      </sensor>
    </link>
    <joint name="drone/imu_joint" type="fixed">
      <child>imu_link</child>
      <parent>base_link</parent>
    </joint>
    <link name="gps_link">
      <pose>0 0 0.05 0 0 0</pose>
      <sensor name="gps_link" type="navsat">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <visualize>0</visualize>
        <topic>drone/gps/navsat</topic>
        <ignition_frame_id>drone/gps_link</ignition_frame_id>
        <pose relative_to='gps_link'>0 0 0 0 0 0</pose>
        <navsat>
          <position_sensing>
            <horizontal>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>4e-10</stddev>
              </noise>
            </horizontal>
            <vertical>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>4e-4</stddev>
              </noise>
            </vertical>
          </position_sensing>
          <velocity_sensing>
            <horizontal>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.1</stddev>
              </noise>
            </horizontal>
            <vertical>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.1</stddev>
              </noise>
            </vertical>
          </velocity_sensing>
        </navsat>
      </sensor>
    </link>
