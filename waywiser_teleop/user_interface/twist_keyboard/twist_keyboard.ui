        <property name="styleSheet">
            <string notr="true">QWidget {
                background-color: #1a1d29;
                color: #e4e6eb;
                font-family: 'Segoe UI', 'Arial', sans-serif;
                }
                QGroupBox {
                border: 1px solid #2d3748;
                border-radius: 12px;
                margin-top: 16px;
                padding-top: 16px;
                font-weight: 600;
                background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #232936, stop:1 #1a1d29);
                font-size: 11pt;
                }
                QGroupBox::title {
                subcontrol-origin: margin;
                left: 20px;
                padding: 0 8px;
                color: #60a5fa;
                }
                QLabel {
                color: #e4e6eb;
                font-size: 10pt;
                }
                QPushButton {
                background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #3b4252, stop:1 #2e3440);
                border: 1px solid #4c566a;
                border-radius: 8px;
                padding: 10px 16px;
                color: #e4e6eb;
                font-weight: 600;
                font-size: 10pt;
                }
                QPushButton:hover {
                background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #4c566a, stop:1 #3b4252);
                border-color: #60a5fa;
                }
                QPushButton:pressed {
                background: #2e3440;
                }
                QProgressBar {
                border: 1px solid #374151;
                border-radius: 6px;
                text-align: center;
                background-color: #1f2937;
                color: #e4e6eb;
                font-weight: 600;
                height: 24px;
                }
                QProgressBar::chunk {
                background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #3b82f6, stop:1 #60a5fa);
                border-radius: 5px;
                }
                QFrame {
                border: 1px solid #2d3748;
                border-radius: 8px;
                background-color: #232936;
                }
                QScrollArea {
                border: none;
                background-color: #1a1d29;
                }</string>
        </property>
