#!/usr/bin/env bash
set -euo pipefail

repo="@PX4_AUTOPILOT_DIR@"
patch_file="@PX4_ZENOH_PATCH_FILE@"
cmake_executable="@CMAKE_COMMAND@"
applied_now=0
kconfig_topics_path="src/modules/zenoh/Kconfig.topics"
zenoh_pico_path="src/modules/zenoh/zenoh-pico"
kconfig_topics_was_clean=0
zenoh_pico_was_clean=0
px4_build_dir="@WAYWISER_PX4_BUILD_DIR@"
px4_artifact_dir="@WAYWISER_PX4_SITL_DIR@"
px4_cache_file="$px4_build_dir/CMakeCache.txt"
cc_executable="${CC:-$(command -v gcc || true)}"
cxx_executable="${CXX:-$(command -v g++ || true)}"
cmake_args="${CMAKE_ARGS:-}"

is_git_worktree() {
  [ -e "$1/.git" ]
}

repair_px4_build_ownership() {
  local path="$1"
  local uid gid

  [ -e "$path" ] || return 0
  [ -w "$path" ] && return 0

  uid="$(id -u)"
  gid="$(id -g)"
  if command -v sudo >/dev/null 2>&1; then
    echo "Repairing PX4 build directory ownership: $path"
    sudo chown -R "$uid:$gid" "$path"
  else
    echo "PX4 build directory is not writable: $path" >&2
    echo "Run: sudo chown -R $uid:$gid '$path'" >&2
    exit 1
  fi
}

restore_px4_patch_paths() {
  echo "Restoring stale PX4 Zenoh patch state before retrying patch application."
  "@GIT_EXECUTABLE@" -C "$repo" restore --source=HEAD --worktree --staged -- "$kconfig_topics_path"

  if is_git_worktree "$repo/$zenoh_pico_path"; then
    "@GIT_EXECUTABLE@" -C "$repo/$zenoh_pico_path" restore --source=HEAD --worktree --staged -- .
    "@GIT_EXECUTABLE@" -C "$repo/$zenoh_pico_path" clean -fd
  fi

  "@GIT_EXECUTABLE@" -C "$repo" submodule update --checkout -- "$zenoh_pico_path"
}

if [ -z "$cc_executable" ] || [ -z "$cxx_executable" ]; then
  echo "Unable to find gcc/g++ for PX4 SITL build." >&2
  exit 1
fi

export CC="$cc_executable"
export CXX="$cxx_executable"
export CMAKE_ARGS="$cmake_args \
  -DCMAKE_C_COMPILER=$cc_executable \
  -DCMAKE_CXX_COMPILER=$cxx_executable"

mkdir -p "$(dirname "$px4_build_dir")" "$(dirname "$px4_artifact_dir")"
repair_px4_build_ownership "$px4_build_dir"

if [ -f "$px4_cache_file" ]; then
  cached_home="$(sed -n 's/^CMAKE_HOME_DIRECTORY:INTERNAL=//p' "$px4_cache_file" | head -n 1)"
  cached_build_dir="$(sed -n 's/^CMAKE_CACHEFILE_DIR:INTERNAL=//p' "$px4_cache_file" | head -n 1)"
  cached_make_program="$(
    sed -n 's/^CMAKE_MAKE_PROGRAM:FILEPATH=//p' "$px4_cache_file" | head -n 1
  )"
  cached_cxx_compiler="$(
    sed -n 's/^CMAKE_CXX_COMPILER:FILEPATH=//p' "$px4_cache_file" | head -n 1
  )"
  if [ "$cached_home" != "$repo" ] \
    || [ "$cached_build_dir" != "$px4_build_dir" ] \
    || { [ -n "$cached_make_program" ] && [ ! -x "$cached_make_program" ]; } \
    || { [ -n "$cached_cxx_compiler" ] && [ ! -x "$cached_cxx_compiler" ]; }; then
    echo "Removing stale PX4 CMake cache from $px4_build_dir"
    rm -rf -- "$px4_build_dir"
  fi
fi

if [ -z "$("@GIT_EXECUTABLE@" -C "$repo" status --porcelain -- "$kconfig_topics_path")" ]; then
  kconfig_topics_was_clean=1
fi

if [ -z "$("@GIT_EXECUTABLE@" -C "$repo" status --porcelain -- "$zenoh_pico_path")" ] \
  && is_git_worktree "$repo/$zenoh_pico_path" \
  && [ -z "$("@GIT_EXECUTABLE@" -C "$repo/$zenoh_pico_path" status --porcelain)" ]; then
  zenoh_pico_was_clean=1
fi

cleanup() {
  if [ "$applied_now" -eq 1 ]; then
    "@GIT_EXECUTABLE@" -C "$repo" apply --reverse "$patch_file"
  fi

  if [ "$kconfig_topics_was_clean" -eq 1 ] \
    && [ -n "$("@GIT_EXECUTABLE@" -C "$repo" status --porcelain -- "$kconfig_topics_path")" ]; then
    "@GIT_EXECUTABLE@" -C "$repo" restore --source=HEAD --worktree -- "$kconfig_topics_path"
  fi

  if [ "$zenoh_pico_was_clean" -eq 1 ]; then
    if is_git_worktree "$repo/$zenoh_pico_path" \
      && [ -n "$("@GIT_EXECUTABLE@" -C "$repo/$zenoh_pico_path" status --porcelain)" ]; then
      "@GIT_EXECUTABLE@" -C "$repo/$zenoh_pico_path" restore --source=HEAD --worktree --staged -- .
      "@GIT_EXECUTABLE@" -C "$repo/$zenoh_pico_path" clean -fd
    fi
    if [ -n "$("@GIT_EXECUTABLE@" -C "$repo" status --porcelain -- "$zenoh_pico_path")" ]; then
      "@GIT_EXECUTABLE@" -C "$repo" submodule update --checkout -- "$zenoh_pico_path"
    fi
  fi
}

trap cleanup EXIT

if "@GIT_EXECUTABLE@" -C "$repo" apply --reverse --check "$patch_file" >/dev/null 2>&1; then
  echo "PX4 Zenoh compatibility patch is already present; building with existing changes."
elif "@GIT_EXECUTABLE@" -C "$repo" apply --check "$patch_file" >/dev/null 2>&1; then
  "@GIT_EXECUTABLE@" -C "$repo" apply "$patch_file"
  applied_now=1
  rm -rf "$px4_build_dir/uORB/idl"
else
  restore_px4_patch_paths
  if "@GIT_EXECUTABLE@" -C "$repo" apply --check "$patch_file" >/dev/null 2>&1; then
    "@GIT_EXECUTABLE@" -C "$repo" apply "$patch_file"
    applied_now=1
    rm -rf "$px4_build_dir/uORB/idl"
  else
    echo "Unable to apply $patch_file cleanly to $repo." >&2
    "@GIT_EXECUTABLE@" -C "$repo" status --short >&2 || true
    exit 1
  fi
fi

cd "$repo"
cmake_generator_args=()
if command -v ninja >/dev/null 2>&1; then
  cmake_generator_args=(-G Ninja)
elif command -v ninja-build >/dev/null 2>&1; then
  cmake_generator_args=(-G Ninja -DCMAKE_MAKE_PROGRAM="$(command -v ninja-build)")
fi

# shellcheck disable=SC2086
"$cmake_executable" -S "$repo" -B "$px4_build_dir" \
  "${cmake_generator_args[@]}" \
  -DCONFIG=px4_sitl_zenoh \
  $CMAKE_ARGS

"$cmake_executable" --build "$px4_build_dir" --target default_topics_config
"$cmake_executable" --build "$px4_build_dir"

rm -rf -- "$px4_artifact_dir"
mkdir -p "$px4_artifact_dir"
cp -a "$px4_build_dir"/. "$px4_artifact_dir"/
