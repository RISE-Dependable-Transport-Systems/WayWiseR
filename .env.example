# List of packages to skip building by default
WAYWISER_SKIPPED_PACKAGES="waywiser_agrarsense waywiser_carla waywiser_gazebo"

# Python virtual environment path.
# Used by 'ros2 run waywiser setup_venv' and the bootstrap.
# Leave empty to use the default: <workspace>/.venv
WAYWISER_VENV_PATH=

# ROS 2 Core Settings
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
RCUTILS_LOGGING_USE_STDOUT=1
RCUTILS_LOGGING_BUFFERED_STREAM=1
PYTHONUNBUFFERED=1
RCUTILS_COLORIZED_OUTPUT=1

# Discovery Settings (FastDDS)
# To use FastDDS, set RMW_IMPLEMENTATION=rmw_fastrtps_cpp above.
# Set to '1' to enable Discovery Server mode. If '0', uses standard Multicast.
FASTDDS_USE_DISCOVERY_SERVER=0
# Optional: IP of the remote Discovery Server (e.g. 192.168.1.100)
FASTDDS_REMOTE_DISCOVERY_SERVER_IP=
# Optional: IP of this client as seen by the remote server
FASTDDS_REMOTE_DISCOVERY_CLIENT_IP=
# Set to '1' if this client should be a Super Client
FASTDDS_SUPER_CLIENT=0

# Discovery Settings (Zenoh)
# To use Zenoh, set RMW_IMPLEMENTATION=rmw_zenoh_cpp above.
# Set to '1' if using a local Zenoh router, preventing nodes from directly connecting to the remote.
ZENOH_USE_LOCAL_ROUTER=1
# Optional: IP of a remote Zenoh router to connect to
ZENOH_REMOTE_ROUTER_IP=
# Optional: Port of the remote Zenoh router (default: 7447)
ZENOH_REMOTE_ROUTER_PORT=7447
# Optional: Router check behavior (-1=skip check, 0=wait forever, N=N attempts)
ZENOH_ROUTER_CHECK_ATTEMPTS=-1
# Optional: Path to custom Zenoh session config file
ZENOH_SESSION_CONFIG_URI=
# Optional: Override specific Zenoh config fields (semicolon-separated key=value pairs)
ZENOH_CONFIG_OVERRIDE=

# Email Settings
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# Custom path to CARLA simulator root directory (containing PythonAPI)
WAYWISER_CUSTOM_CARLA_ROOT=
